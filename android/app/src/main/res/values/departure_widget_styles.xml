<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Parent of the row styles below; dotted names inherit from it. -->
    <style name="DepartureWidget" />

    <!-- A minimum rather than a fixed width, so "RE16" still fits at large
         font sizes; the destination gets the remaining space. -->
    <style name="DepartureWidget.Line">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DepartureWidget.Destination">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DepartureWidget.Time">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DepartureWidget.Delay">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">@color/widget_error</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
